PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/codebase_massage
JWT_SECRET=change_me_super_secret_dev_only
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# In dev, OTP is bypassed: any 6-digit code is accepted.
DEV_BYPASS_OTP=true

# Admin panel login (default: admin123)
ADMIN_PASSWORD=admin123

# Expo push — set true when shipping to devices
EXPO_PUSH_ENABLED=false

# SMS (optional — leave blank for dev console logging)
# MSG91_API_KEY=
# MSG91_SENDER=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Payments (optional — test mode when blank)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Coupons: CODE:discount_inr (comma-separated)
COUPON_CODES=WELCOME10:10,RELAX20:20

# Dispatch tuning
H3_RESOLUTION=8
# Increase DISPATCH_SLA_MINUTES locally if testing far from seeded experts (Bengaluru ~12.97, 77.64)
DISPATCH_SLA_MINUTES=15
DISPATCH_OFFER_TIMEOUT_SEC=30
EXPERT_AVG_SPEED_KMPH=22

# CORS allow-list (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:19006,http://localhost:8081
